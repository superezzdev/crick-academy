# -------------------------------------------------------------
# Supabase & Prisma Database Connection Strings
# -------------------------------------------------------------
# Transaction connection pooler (Session / Transaction mode on Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database (used for Prisma migrations & db push)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# -------------------------------------------------------------
# Supabase Client Credentials
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -------------------------------------------------------------
# App Configuration
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CrickAcademy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
